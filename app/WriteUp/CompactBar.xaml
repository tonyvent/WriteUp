<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WriteUp.CompactBar" Title="WriteUp — recording" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="Height" WindowStartupLocation="Manual" Width="620">
    <Border x:Name="Root" CornerRadius="10" Background="#FF1E1E20" Padding="12,7" Margin="16" MouseLeftButtonDown="Root_MouseLeftButtonDown" Cursor="SizeAll">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.45" Color="#FF000000"/>
        </Border.Effect>
        <StackPanel VerticalAlignment="Center">
            <WrapPanel>
                <!-- drag handle -->
                <TextBlock Text="⠿" Foreground="#FF6B6B6B" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Drag to move"/>
                <Ellipse Width="11" Height="11" Fill="{StaticResource StopBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="REC" Foreground="White" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding Elapsed}" Foreground="#FFDDDDDD" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Text="  ·  " Foreground="#FF888888" VerticalAlignment="Center"/>
                <TextBlock VerticalAlignment="Center" Foreground="#FFDDDDDD" FontSize="12">
                    <Run Text="{Binding StepCount, Mode=OneWay}"/>
                    <Run Text=" steps"/>
                </TextBlock>
                <Button Content="＋ Note" Style="{StaticResource BaseButton}" Background="#FF3A3A3D" Padding="10,6" FontSize="12" Margin="8,4,0,4" Click="Note_Click"/>
                <Button Content="{Binding MicrophoneLabel}" Click="Narration_Click" Padding="10,6" Margin="8,4,0,4"/>
                <Button Content="■ Stop" Style="{StaticResource BaseButton}" Background="{StaticResource StopBrush}" Padding="12,6" FontSize="12" Margin="8,4,0,4" Click="Stop_Click"/>
            </WrapPanel>
            <ProgressBar Value="{Binding AudioLevel}" Maximum="100" Height="6" Margin="0,8,0,4"/>
            <ScrollViewer MaxHeight="64" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding RecordingNotice}" TextWrapping="Wrap" Foreground="White" FontSize="11"/>
                    <TextBlock Text="{Binding LiveTranscript}" TextWrapping="Wrap" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                </StackPanel>
            </ScrollViewer>
        </StackPanel>
    </Border>
</Window>