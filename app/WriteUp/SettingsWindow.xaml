<Window x:Class="WriteUp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="620" Height="760" MinWidth="480" MinHeight="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource BgBrush}"
        UseLayoutRounding="True">

    <DockPanel Margin="18">
        <Grid Margin="0,12,0,0" DockPanel.Dock="Bottom">
            <Button Content="Cancel" Style="{StaticResource GhostButton}"
                    HorizontalAlignment="Left" Click="Cancel_Click"/>
            <Button Content="Save" Style="{StaticResource BaseButton}" MinWidth="100"
                    HorizontalAlignment="Right" Click="Save_Click"/>
        </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

        <TextBlock Text="Settings" FontSize="18" FontWeight="Bold"
                   Foreground="{StaticResource InkBrush}" Margin="0,0,0,12"/>


        <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="MICROPHONE AND NARRATION" Style="{StaticResource FieldLabel}"/>
                <CheckBox x:Name="NarrationCheck" Margin="0,8,0,10">
                    <TextBlock Text="Listen and transcribe automatically when recording starts" TextWrapping="Wrap"/>
                </CheckBox>
                <TextBlock Text="Microphone" Margin="0,4,0,4"/>
                <ComboBox x:Name="MicrophoneBox" Margin="0,0,0,10"/>
                <TextBlock Text="Speech recognition language" Margin="0,4,0,4"/>
                <ComboBox x:Name="LanguageBox" Margin="0,0,0,10"/>
                <WrapPanel>
                    <Button x:Name="TestMicBtn" Content="Test microphone" Click="TestMic_Click" Margin="0,0,8,8"/>
                    <Button Content="Refresh devices" Click="RefreshDevices_Click" Margin="0,0,8,8"/>
                    <Button Content="Windows sound settings" Click="SoundSettings_Click" Margin="0,0,8,8"/>
                </WrapPanel>
                <ProgressBar x:Name="MicLevel" Minimum="0" Maximum="100" Height="10" Margin="0,0,0,8"/>
                <TextBlock x:Name="MicStatus" Text="Test the selected microphone and language before recording." TextWrapping="Wrap"/>
                <TextBlock x:Name="TestTranscript" TextWrapping="Wrap" Margin="0,8,0,0" FontWeight="SemiBold"/>
                <TextBlock Text="Transcription runs on this PC. Turn narration off to record screenshots without microphone input. If no language is listed, install a Windows speech language first." TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
        <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="RECORDING" Style="{StaticResource FieldLabel}"/>
                <CheckBox x:Name="ClicksCheck" Content="Capture mouse clicks and screenshots" Margin="0,8,0,6"/>
                <CheckBox x:Name="TypingCheck" Content="Capture typing and navigation keys" Margin="0,0,0,6"/>
                <CheckBox x:Name="ScrollCheck" Content="Capture scroll actions" Margin="0,0,0,6"/>
                <CheckBox x:Name="WindowChangesCheck" Content="Capture window changes without a click" Margin="0,0,0,6"/>
                <CheckBox x:Name="CompactCheck" Content="Use the compact recording bar" Margin="0,0,0,6"/>
                <TextBlock Text="Recording settings apply on the next recording. Ctrl+Alt+R starts/stops, Ctrl+Alt+S captures the current screen, and Ctrl+Alt+A captures all screens." TextWrapping="Wrap" FontSize="12"/>
            </StackPanel>
        </Border>
        <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="14"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="GUIDED TOUR" Style="{StaticResource FieldLabel}"/>
                <CheckBox x:Name="TourCheck" Content="Show the guided tour when the app starts"
                          Margin="0,6,0,10" Foreground="{StaticResource InkBrush}"/>
                <Button Content="Show tour now" Style="{StaticResource GhostButton}"
                        Padding="12,7" HorizontalAlignment="Left" Click="ShowTourNow_Click"/>
            </StackPanel>
        </Border>

        <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="14"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="SESSIONS" Style="{StaticResource FieldLabel}"/>
                <CheckBox x:Name="CleanupCheck" Margin="0,6,0,4"
                          Foreground="{StaticResource InkBrush}"
                          Content="Delete session folders when the app closes"/>
                <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                           Text="Off: sessions (steps, screenshots, annotations) are kept and can be reopened later with 📂 Open… — they accumulate on disk until you delete them. On: capture folders are wiped on exit and past sessions cannot be reopened."/>
            </StackPanel>
        </Border>

        <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="14"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="SCREENSHOTS" Style="{StaticResource FieldLabel}"/>
                <TextBlock TextWrapping="Wrap" Text="Maximum width (px). Use 0 to retain full resolution."
                           FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,6"/>
                <TextBox x:Name="MaxWidthBox" Width="120" HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>

        <!-- Report a problem: collapsed by default; the pieces here are the seam
             for a richer feedback flow later. -->
        <Expander Header="Report a problem" Margin="0,0,0,14"
                  Foreground="{StaticResource InkBrush}">
            <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="14"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}"
                               Margin="0,0,0,10"
                               Text="Tell us what went wrong or what you'd like added. Reports are saved on this PC so they can be collected."/>

                    <TextBlock Text="TYPE" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="FeedbackCategory" SelectedIndex="0" Width="190"
                              HorizontalAlignment="Left" Margin="0,4,0,10">
                        <ComboBoxItem Content="Bug"/>
                        <ComboBoxItem Content="Feature request"/>
                        <ComboBoxItem Content="Other"/>
                    </ComboBox>

                    <TextBlock Text="DETAILS" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="FeedbackMessage" Height="92" Margin="0,4,0,10"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>

                    <TextBlock Text="YOUR NAME OR EMAIL (OPTIONAL)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="FeedbackContact" Margin="0,4,0,12"/>

                    <Button Content="Send report" Style="{StaticResource GhostButton}" Padding="12,7"
                            HorizontalAlignment="Left" Click="SendFeedback_Click"/>
                </StackPanel>
            </Border>
        </Expander>

        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
